{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runbook",
  "version": "0.1.1",
  "identifier": "dev.runbook.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:frontend",
    "beforeBuildCommand": "npm run prepare:frontend",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"Runbook","url":"projects.html","width":1440,"height":900,"minWidth":800,"minHeight":640}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {"active":false}
}
