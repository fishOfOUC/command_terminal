{
  "name": "runbook-desktop",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "prepare:frontend": "node scripts/prepare-frontend.mjs",
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "build:cli": "cargo build --release -p runbook-cli",
    "test": "cargo test -p runbook-core -p runbook-cli -p runbook-update",
    "test:update": "node scripts/update-smoke.mjs",
    "test:projects": "node scripts/project-ux-smoke.mjs",
    "test:gui": "node scripts/gui-smoke.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "test:terminal-state": "node --test scripts/terminal-state.test.cjs",
    "test:ui": "node --test scripts/terminal-state.test.cjs scripts/theme.test.cjs",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "tree": "node scripts/show-tree.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": { "@tauri-apps/cli": "2.12.4" }
}
